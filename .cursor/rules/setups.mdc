## Examples

### 🔹 Phoenix Project

```yaml
version: 1
name: "Phoenix Local Setup"
env: { secrets: [DATABASE_URL] }

bootstrap:
  - ensure_package_manager: { type: auto }
  - ensure_tool:
      name: git
      version: ">=2.34"
      install:
        brew:  { formula: git }
        apt:   { packages: [git], update: true }
        choco: { packages: [git] }

provision:
  - name: "Erlang runtime"
    ensure_runtime:
      name: erlang
      version: "26.x"
      manager: { asdf: true }
      fallback_installers:
        - brew:  { formula: erlang }
        - apt:   { packages: [erlang] }
        - choco: { packages: [erlang] }

  - name: "Elixir runtime"
    ensure_runtime:
      name: elixir
      version: "1.16.x"
      manager: { asdf: true }
      fallback_installers:
        - brew:  { formula: elixir }
        - apt:   { packages: [elixir] }
        - choco: { packages: [elixir] }

  - ensure_database:
      engine: postgres
      version: "15"
      service_name: "postgres"
      ensure_running: true
      create_db: ["app_dev"]

setup:
  - run: mix local.hex --force && mix local.rebar --force
  - run: mix deps.get
  - run: npm ci
    if: file_exists("assets/package-lock.json")
  - run: npm install
    if: file_exists("assets/package.json") && !file_exists("assets/package-lock.json")
  - run: mix ecto.setup
    env_from_secrets: [DATABASE_URL]

verify:
  - assert_command: "mix --version"
  - assert_http:
      url: "http://localhost:4000/health"
      expect_status: 200
      retries: { attempts: 20, backoff: "1s" }

post:
  - print: "✅ Setup complete. Start: mix phx.server"
```

